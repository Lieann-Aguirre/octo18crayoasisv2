---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import {categoryPhotography,selectFeatured,selectPaperHighlights} from '../lib/homepage';
import {products,categories,image,settings} from '../lib/catalog';
const featured=selectFeatured(products);
const paperHighlights=selectPaperHighlights(products,featured);
const stockedCategories=categories.map(c=>({...c,count:products.filter(p=>p.category===c.slug).length,photo:products.find(p=>p.id===categoryPhotography[c.slug]&&p.category===c.slug)||products.find(p=>p.category===c.slug)})).filter(c=>c.count>0);
const popular=products.filter(p=>p.popular),arrivals=products.filter(p=>p.newArrival);
---
<Base wide title="School & office supplies in Manila">
<h1 class="sr-only">School, office and stationery essentials in Manila</h1>
<HeroCarousel/>
<section class="benefit-bar"><div class="container"><div><Icon name="truck" size={26}/><span><strong>Delivered your way</strong><small>Metro Manila & courier options</small></span></div><div><Icon name="pin" size={26}/><span><strong>Your local supply partner</strong><small>Pickup in Tondo, Manila</small></span></div><div><Icon name="bag" size={26}/><span><strong>Big lists, welcome</strong><small>Bulk & custom inquiries</small></span></div><div><Icon name="chat" size={26}/><span><strong>Real people, ready to help</strong><small>Let’s find what you need</small></span></div></div></section>
<section class="section container everyday-favourites"><div class="section-heading"><div class="favourites-heading"><span class="eyebrow">Find your everyday favourites</span><h2>A place for <span>every little thing.</span></h2></div><a class="text-link" href="/categories/">All categories <Icon name="arrow" size={17}/></a></div><form action="/products/" class="search-form home-search" role="search"><label class="sr-only" for="home-search">Search the catalog</label><input id="home-search" type="search" name="q" placeholder="What’s on your list? Search pens, paper, brands…"/><button class="button" type="submit" aria-label="Search the catalog"><Icon name="search"/></button></form><div class="category-grid">{stockedCategories.map(c=><a href={`/categories/${c.slug}/`} class="category-tile photographic-category"><div class="category-photo">{c.photo?<img src={image(c.photo)} srcset={image(c.photo).startsWith('/product-images/')?`${image(c.photo).replace('-480','-240')} 240w, ${image(c.photo)} 480w`:undefined} sizes="(max-width:560px) 42vw, (max-width:1000px) 28vw, 280px" alt="" width="480" height="480" loading="lazy" decoding="async"/>:null}<span class="category-type-treatment" hidden={Boolean(c.photo)} aria-hidden="true">{c.name}</span></div><div class="category-details"><h3>{c.name}</h3><p class="category-caption">{c.description}</p><span class="category-count">{c.count} essentials <span class="category-arrow" aria-hidden="true">↗</span></span></div></a>)}</div></section>
<section class="section featured-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">Selected for your everyday</span><h2>Featured picks for your everyday.</h2></div><a class="text-link" href="/products/">Browse all products <Icon name="arrow" size={17}/></a></div><div class="product-grid">{featured.map(p=><ProductCard product={p}/>)}</div></div></section>
{popular.length>0&&<section class="section container"><div class="section-heading"><h2>Popular picks</h2></div><div class="product-grid">{popular.slice(0,4).map(p=><ProductCard product={p}/>)}</div></section>}
{arrivals.length>0&&<section class="section container"><div class="section-heading"><h2>Fresh for your desk</h2></div><div class="product-grid">{arrivals.slice(0,4).map(p=><ProductCard product={p}/>)}</div></section>}
<section class="section container collection-grid"><a class="collection school" href="/collections/school/"><span class="eyebrow">Ready, set, learn</span><h2>Little supplies.<br/>Big school days.</h2><p>For curious minds and colourful classrooms.</p><span class="text-link">Explore school supplies <Icon name="arrow"/></span></a><a class="collection office" href="/collections/office/"><span class="eyebrow">Make work, work better</span><h2>Your desk.<br/>Only better.</h2><p>Everyday essentials for a productive workspace.</p><span class="text-link">Explore office supplies <Icon name="arrow"/></span></a></section>
{paperHighlights.length>0&&<section class="section paper-highlights"><div class="container"><div class="section-heading"><div><span class="eyebrow">Paper & printing supplies</span><h2>Paper for your next print run.</h2><p>Compare sizes, weights and packs. Find the right fit for your list.</p></div><a class="text-link" href="/categories/paper-printing/">Browse all paper <Icon name="arrow" size={18}/></a></div><div class="product-grid">{paperHighlights.map(p=><ProductCard product={p}/>)}</div></div></section>}
<section class="section container quotation-guide"><div class="section-heading"><div><span class="eyebrow">From browsing to a clearer estimate</span><h2>Your next supply run, made simple.</h2></div><a class="text-link" href="/request-a-quote/">Start your quotation <Icon name="arrow" size={18}/></a></div><ol class="quotation-steps"><li><span aria-hidden="true">01</span><h3>Choose your supplies</h3><p>Browse products and select the sizes, colours and options you need.</p></li><li><span aria-hidden="true">02</span><h3>Review your estimate</h3><p>Adjust quantities in your quote list and see the estimated cost of priced items.</p></li><li><span aria-hidden="true">03</span><h3>Send your request</h3><p>Share your details. We’ll confirm availability, final pricing and delivery arrangements.</p></li></ol></section>
<section class="container bulk-banner"><div><span class="eyebrow">A bigger list? We’ve got you.</span><h2>One classroom. A whole office.<br/>Let’s get you stocked.</h2><p>Share your list, quantities and ideas. We’ll help put a quotation together.</p></div><a class="button yellow" href="/request-a-quote/">Request a quotation <Icon name="arrow"/></a></section>
{settings.reviews.some(r=>r.permissionConfirmed)&&<section class="section container"><div class="section-heading"><div><span class="eyebrow">Kind words from our customers</span><h2>A little trust goes a long way.</h2></div></div><div class="info-grid">{settings.reviews.filter(r=>r.permissionConfirmed).map(r=><blockquote class="info-card"><p>“{r.quote}”</p><cite>{r.name}</cite></blockquote>)}</div></section>}
<section class="section container story-grid"><div><span class="eyebrow">Hello from Manila</span><h2>Small details.<br/>A more thoughtful everyday.</h2><p>We’re Octo18 Crayoasis Stationery — your Manila partner for school, office and creative essentials. We believe finding the right supplies should feel simple and personal.</p><a class="text-link" href="/about/">A little more about us <Icon name="arrow"/></a></div><div class="delivery-card"><Icon name="truck" size={34}/><h3>From our shelves to your space.</h3><p>Metro Manila delivery, Lalamove or Grab by arrangement, Tondo pickup, and courier options outside Metro Manila.</p><a class="text-link" href="/delivery/">Delivery & pickup details ↗</a><small>Coverage, delivery fees and timing confirmed with your quote.</small></div></section>
</Base>
