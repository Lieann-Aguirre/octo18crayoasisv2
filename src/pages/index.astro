---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import CategoryArt from '../components/CategoryArt.astro';
import {products,categories,image,settings} from '../lib/catalog';
const picks=products.filter(p=>p.featured);const featured=(picks.length?picks:[...products.filter(p=>p.category==='pens-writing').slice(0,2),...products.filter(p=>p.category==='paper-printing').slice(0,1),...products.filter(p=>p.category==='notebooks-record-books').slice(0,1)]).slice(0,4);
const heroProducts=[products.find(p=>p.brand==='Stabilo'),products.find(p=>p.brand==='Mongol'),products.find(p=>p.brand==='Dong-A')].filter(Boolean);
const popular=products.filter(p=>p.popular),arrivals=products.filter(p=>p.newArrival);
---
<Base wide title="School & office supplies in Manila">
<section class="hero retail-hero"><div class="container retail-hero-grid"><div class="hero-copy"><span class="pill">SCHOOL · OFFICE · EVERYDAY CREATIVITY</span><h1>Big ideas.<br/><em>Start here.</em></h1><p>Make room for your next bright idea. Discover paper, pens and everyday essentials for your classroom, workspace and creative projects.</p><div class="button-row"><a class="button" href="/products/">Shop supplies <Icon name="arrow"/></a><a class="button secondary" href="/request-a-quote/">Request a quotation</a></div><p class="hero-service">Manila-based service · Tondo pickup by arrangement</p></div><div class="retail-hero-products"><span class="hero-campaign-label">GOOD THINGS FOR YOUR DESK</span>{heroProducts.slice(0,2).map(p=>p&&<a href={`/products/${p.slug}/`}><img src={image(p)} alt={p.name} width="400" height="400"/><span>{p.brand} essentials <Icon name="arrow" size={17}/></span></a>)}<span class="campaign-note">A little colour. A fresh start.</span></div></div></section>
<section class="benefit-bar"><div class="container"><div><Icon name="truck" size={26}/><span><strong>Delivered your way</strong><small>Metro Manila & courier options</small></span></div><div><Icon name="pin" size={26}/><span><strong>Your local supply partner</strong><small>Pickup in Tondo, Manila</small></span></div><div><Icon name="bag" size={26}/><span><strong>Big lists, welcome</strong><small>Bulk & custom inquiries</small></span></div><div><Icon name="chat" size={26}/><span><strong>Real people, ready to help</strong><small>Let’s find what you need</small></span></div></div></section>
<section class="section container everyday-favourites"><div class="section-heading"><div class="favourites-heading"><span class="eyebrow">FIND YOUR EVERYDAY FAVOURITES</span><h2>A place for <span class="favourites-underline">every little thing.</span></h2><svg class="favourites-doodle" viewBox="0 0 70 65" fill="none" aria-hidden="true"><path d="m24 8 4 15 15 4-15 4-4 15-4-15-15-4 15-4zM52 40l3 8 8 3-8 3-3 8-3-8-8-3 8-3z" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/></svg></div><a class="text-link" href="/categories/">All categories <Icon name="arrow" size={17}/></a></div><form action="/products/" class="search-form home-search" role="search"><label class="sr-only" for="home-search">Search the catalog</label><input id="home-search" type="search" name="q" placeholder="What’s on your list? Search pens, paper, brands…"/><button class="button" type="submit" aria-label="Search the catalog"><Icon name="search"/></button></form><div class="category-grid">{categories.map((c,i)=><a href={`/categories/${c.slug}/`} class={`category-tile category-${i}`}><div class="category-illustration"><CategoryArt slug={c.slug}/></div><h3>{c.name}</h3><p class="category-caption">{c.description}</p><span class="category-count">{products.filter(p=>p.category===c.slug).length} essentials <span class="category-arrow" aria-hidden="true">↗</span></span></a>)}</div></section>
<section class="section featured-section"><div class="container"><div class="section-heading"><div><span class="eyebrow">GOOD THINGS FOR YOUR DESK</span><h2>Featured picks for your everyday.</h2></div><a class="text-link" href="/products/">Browse all products <Icon name="arrow" size={17}/></a></div><div class="product-grid">{featured.map(p=><ProductCard product={p}/>)}</div></div></section>
{popular.length>0&&<section class="section container"><div class="section-heading"><h2>Popular picks</h2></div><div class="product-grid">{popular.slice(0,4).map(p=><ProductCard product={p}/>)}</div></section>}
{arrivals.length>0&&<section class="section container"><div class="section-heading"><h2>Fresh for your desk</h2></div><div class="product-grid">{arrivals.slice(0,4).map(p=><ProductCard product={p}/>)}</div></section>}
<section class="section container collection-grid"><a class="collection school" href="/collections/school/"><span class="eyebrow">READY, SET, LEARN</span><h2>Little supplies.<br/>Big school days.</h2><p>For curious minds and colourful classrooms.</p><span class="text-link">Explore school supplies <Icon name="arrow"/></span><span class="collection-art" aria-hidden="true">✎</span></a><a class="collection office" href="/collections/office/"><span class="eyebrow">MAKE WORK, WORK BETTER</span><h2>Your desk.<br/>Only better.</h2><p>Everyday essentials for a productive workspace.</p><span class="text-link">Explore office supplies <Icon name="arrow"/></span><span class="collection-art" aria-hidden="true">▤</span></a></section>
<section class="container bulk-banner"><span class="bulk-doodle" aria-hidden="true">✳</span><div><span class="eyebrow">A BIGGER LIST? WE’VE GOT YOU.</span><h2>One classroom. A whole office.<br/>Let’s get you stocked.</h2><p>Share your list, quantities and ideas. We’ll help put a quotation together.</p></div><a class="button yellow" href="/request-a-quote/">Request a quotation <Icon name="arrow"/></a></section>
{settings.reviews.some(r=>r.permissionConfirmed)&&<section class="section container"><div class="section-heading"><div><span class="eyebrow">KIND WORDS FROM OUR CUSTOMERS</span><h2>A little trust goes a long way.</h2></div></div><div class="info-grid">{settings.reviews.filter(r=>r.permissionConfirmed).map(r=><blockquote class="info-card"><p>“{r.quote}”</p><cite>{r.name}</cite></blockquote>)}</div></section>}
<section class="section container story-grid"><div><span class="eyebrow">HELLO FROM MANILA</span><h2>Small details.<br/>A more thoughtful everyday.</h2><p>We’re Octo18 Crayoasis Stationery — your Manila partner for school, office and creative essentials. We believe finding the right supplies should feel simple and personal.</p><a class="text-link" href="/about/">A little more about us <Icon name="arrow"/></a></div><div class="delivery-card"><Icon name="truck" size={34}/><h3>From our shelves to your space.</h3><p>Metro Manila delivery, Lalamove or Grab by arrangement, Tondo pickup, and courier options outside Metro Manila.</p><a class="text-link" href="/delivery/">Delivery & pickup details ↗</a><small>Coverage, delivery fees and timing confirmed with your quote.</small></div></section>
</Base>
