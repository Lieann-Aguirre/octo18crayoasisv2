---
import Base from '../layouts/Base.astro';import {settings} from '../lib/catalog';
const key=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY||'';
---
<Base title="Request a stationery quotation in Manila" description="Build a school or office supply list and request a quotation from Octo18 Crayoasis Stationery, Manila."><section class="page-heading"><div class="container"><span class="eyebrow">LET’S MAKE YOUR LIST HAPPEN</span><h1>A quotation, made for you.</h1><p>Choose your supplies or tell us what you need. We’ll confirm the details personally.</p></div></section><div class="container quote-layout"><aside class="quote-panel"><h2>Your supply list</h2><div id="quote-items"><p class="note">Your quote list will appear here. You can also describe a request in the form.</p></div><a class="text-link" href="/products/">+ Browse more supplies</a><p class="note">Quantities refer to each product’s selling unit. Pack contents and prices will be confirmed in your quotation.</p><noscript><p>JavaScript is needed to manage the quote list and submit this form. Please email <a href={`mailto:${settings.email}`}>{settings.email}</a> or call <a href={`tel:${settings.phone}`}>{settings.phone}</a> to share your request.</p></noscript></aside><form id="quote-form"><h2 style="font-size:1.4rem;margin-bottom:25px">A few details to get started.</h2><div class="form-error" id="quote-error" role="alert" hidden></div><div class="form-grid"><div class="field"><label for="name">Your name *</label><input id="name" name="name" autocomplete="name" maxlength="120" minlength="2" required/></div><div class="field"><label for="email">Email address *</label><input id="email" name="email" type="email" autocomplete="email" maxlength="200" required/></div><div class="field"><label for="phone">Phone / WhatsApp</label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="50"/></div><div class="field"><label for="organisation">School or organisation</label><input id="organisation" name="organisation" autocomplete="organization" maxlength="200"/></div><div class="field"><label for="city">Delivery city / province *</label><input id="city" name="city" autocomplete="address-level2" minlength="2" maxlength="120" required/></div><div class="field"><label for="delivery">Preferred arrangement *</label><select id="delivery" name="delivery"><option value="delivery">Delivery — confirm with quotation</option><option value="pickup">Tondo pickup — by arrangement</option></select></div><div class="field full"><label for="requiredDate">Target date, if you have one</label><input id="requiredDate" name="requiredDate" type="date"/><span class="note">Subject to availability and confirmed lead times.</span></div><div class="field full"><label for="notes">Tell us what you need</label><textarea id="notes" name="notes" maxlength="5000" placeholder="Items, quantities, preferred brands, custom ideas or questions…"></textarea><span class="note">If your list is empty, describe your request in at least 10 characters.</span></div></div><label class="checkbox-label"><input type="checkbox" name="privacy" required/><span>I have read the <a href="/privacy/" style="text-decoration:underline">Privacy Notice</a> and understand my details will be used to respond to this request. *</span></label>{key?<div class="cf-turnstile" data-sitekey={key} data-theme="light"/>:<p class="admin-warning">Online submissions will be enabled when spam protection and the inquiry service are configured. You can contact us directly below.</p>}<button class="button" type="submit" disabled={!key}>Send my quote request →</button><p class="note">A request does not reserve stock or confirm an order. Read our <a href="/quotation-terms/" style="text-decoration:underline">quotation terms</a>.</p><a class="text-link" href={`mailto:${settings.email}`}>Prefer email? Send your list directly ↗</a></form></div>{key&&<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer/>}</Base>
