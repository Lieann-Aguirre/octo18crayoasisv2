---
import Base from '../layouts/Base.astro';import Icon from '../components/Icon.astro';import {settings,wa} from '../lib/catalog';
const pages={about:{title:'A little more about us',eyebrow:'HELLO FROM MANILA',description:'Meet Octo18 Crayoasis Stationery, your partner for school, office and creative essentials in Manila.'},contact:{title:'Let’s get your list sorted.',eyebrow:'SAY HELLO',description:'Reach Octo18 Crayoasis Stationery by WhatsApp, email or phone. Arrange delivery or pickup in Tondo, Manila.'},delivery:{title:'From our shelves to your space.',eyebrow:'DELIVERY & PICKUP',description:'Metro Manila delivery, Tondo pickup and courier shipping by arrangement. Confirm coverage and fees with your quotation.'},faq:{title:'A few things you might be wondering.',eyebrow:'HERE TO HELP',description:'Answers about stationery orders, quotations, delivery, pickup and custom requests.'},'bulk-custom-orders':{title:'Big lists. Bright possibilities.',eyebrow:'BULK & CUSTOM REQUESTS',description:'Request bulk school and office supplies or discuss a custom stationery idea. Minimums and feasibility confirmed individually.'},privacy:{title:'Your details, handled with care.',eyebrow:'PRIVACY NOTICE',description:'How Octo18 Crayoasis Stationery handles contact details and quotation inquiries.'},'quotation-terms':{title:'A clear start to your quotation.',eyebrow:'QUOTATION TERMS',description:'Understand indicative prices, availability, delivery charges and quotation confirmation.'},'quote-confirmation':{title:'Your request is on our list.',eyebrow:'THANK YOU',description:'Your quotation request confirmation.'}};
export function getStaticPaths(){return ['about','contact','delivery','faq','bulk-custom-orders','privacy','quotation-terms','quote-confirmation'].map(page=>({params:{page}}));}
const page=Astro.params.page as keyof typeof pages;const info=pages[page];
---
<Base title={info.title} description={info.description} noindex={page==='quote-confirmation'}><section class="page-heading"><div class="container"><span class="eyebrow">{info.eyebrow}</span><h1>{info.title}</h1><p>{info.description}</p></div></section><section class="container content-section">
{page==='about'&&<div class="story-grid"><div class="prose"><img class="brand-logo about-logo" src="/brand/logo-full.png" width="325" height="144" alt="Octo18 CrayOasis — Stationery Trading"/><h2>Good supplies. A personal touch.</h2><p>Octo18 Crayoasis Stationery is based in Manila, Philippines. We help students, parents, teachers, schools and businesses find the supplies they need for everyday work and bigger projects.</p><p>Our catalog brings together writing tools, copy paper, notebooks, filing supplies and office essentials. Browse at your own pace, share your list, and talk to us about what works for your needs.</p><p>Renz Feliciano handles your inquiries personally. Whether you’re choosing a few essentials or preparing a bulk request, we’ll confirm the details with you before you order.</p><a class="button" href="/contact/">Let’s talk <Icon name="arrow"/></a></div><div class="delivery-card"><span class="eyebrow">OUR APPROACH</span><h2>Helpful from the first hello.</h2><p>Clear product details. Thoughtful recommendations. Pricing and availability confirmed with your quotation.</p><p>Pickup in Tondo, Manila by arrangement, with delivery and courier options to discuss.</p></div></div>}
{page==='contact'&&<><div class="info-grid"><div class="info-card"><Icon name="chat" size={30}/><h2 style="font-size:1.35rem">Send a WhatsApp</h2><p>A quick question or a whole supply list — send it our way.</p><a class="text-link" data-channel="whatsapp" href={wa('Hello Octo18! I have an inquiry.')}>{settings.phone} ↗</a></div><div class="info-card"><Icon name="mail" size={30}/><h2 style="font-size:1.35rem">Write to us</h2><p>Share product details, quantities and your delivery city.</p><a class="text-link" data-channel="email" href={`mailto:${settings.email}`}>{settings.email}</a></div><div class="info-card"><Icon name="phone" size={30}/><h2 style="font-size:1.35rem">Have a conversation</h2><p>Call us to discuss your stationery requirements.</p><a class="text-link" data-channel="call" href={`tel:${settings.phone}`}>{settings.phone} ↗</a></div></div><div class="prose"><h2>Find us in Tondo, Manila</h2><p>{settings.pickup}</p><p>{settings.hours}</p><h2>Connect on Facebook</h2>{settings.facebook?<a class="button secondary" href={settings.facebook} data-channel="messenger">Visit our Facebook Page ↗</a>:<p>Our Facebook Page link will be added here once confirmed. You can reach us now by WhatsApp, phone or email.</p>}<h2>Have a list ready?</h2><p>Add items from the catalog or describe your requirements in a quotation request.</p><a class="button" href="/request-a-quote/">Request a quotation</a></div></>}
{page==='delivery'&&<div class="prose"><h2>Metro Manila delivery</h2><p>{settings.delivery}</p><h2>Lalamove or Grab arrangements</h2><p>For local deliveries, ask us about arranging Lalamove or Grab. We confirm service availability, booking responsibility, delivery fees and dispatch timing before proceeding.</p><h2>Pickup in Tondo</h2><p>{settings.pickup}</p><h2>Outside Metro Manila</h2><p>Share your city and province so we can check courier options. Coverage, packaging requirements, fees and delivery estimates depend on the destination and goods.</p><h2>Before dispatch</h2><p>We’ll confirm your items, quantities, delivery details and agreed arrangements. Website shipping information is guidance; your quotation confirms the details for your request.</p><h2>Delivery concerns</h2><p>If an item arrives damaged or something appears incorrect, contact us promptly with your quotation reference and clear photos of the packaging and item. We’ll review the details with you and explain the next steps.</p><a class="button" href="/contact/">Discuss your delivery</a></div>}
{page==='faq'&&<div class="faq-list">{settings.faq.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div>}
{page==='bulk-custom-orders'&&<div class="prose"><h2>For classrooms, teams and growing businesses.</h2><p>Preparing a school supply list, replenishing office essentials or planning a project? Send your items and quantities in one request so we can discuss availability and an indicative budget.</p><h2>What to include</h2><ul><li>Product names, specifications, preferred brands and quantities.</li><li>Delivery city or a preference for Tondo pickup.</li><li>Your target date and any acceptable alternatives.</li><li>For custom ideas: dimensions, materials, design requirements and quantities.</li></ul><h2>Custom requests start with a conversation</h2><p>We assess custom stationery requests individually. Minimum quantities, production feasibility, artwork requirements, samples and lead times must be confirmed before an order is accepted.</p><h2>How it works</h2><ol><li>Send your list or idea.</li><li>We clarify specifications and check options.</li><li>You receive a quotation with the proposed details.</li><li>We agree on the next steps together.</li></ol><a class="button" href="/request-a-quote/">Share your requirements <Icon name="arrow"/></a></div>}
{page==='privacy'&&<div class="prose"><p>Effective date: 19 October 2026.</p><h2>Who handles your details</h2><p>{settings.businessName}, Manila, Philippines. For questions about your information, email <a href={`mailto:${settings.email}`}>{settings.email}</a> or call {settings.phone}.</p><h2>Information you provide</h2><p>When you request a quotation, we collect your name, email, optional phone and organisation, delivery city, preferences, requested items, target date and message. Please avoid sending sensitive personal information.</p><h2>How we use it</h2><p>We use these details to respond, prepare quotations, coordinate requested services and keep a record of our conversation. Sending a request does not subscribe you to marketing messages.</p><h2>Service providers and storage</h2><p>The website uses Cloudflare for hosting, database storage, image delivery, security and spam prevention. Resend delivers inquiry notifications. Access to our inquiry dashboard is restricted to the business administrator. These providers may process information outside the Philippines.</p><h2>Retention and your requests</h2><p>We retain inquiry information while it is needed to respond and manage the business relationship. We review closed requests periodically and remove records no longer needed, subject to applicable recordkeeping obligations. Contact us to request access, correction or deletion of your information.</p><h2>Browser storage and analytics</h2><p>Your quote list is stored in your browser until you clear or submit it. If website analytics are enabled, they measure page visits and actions such as contact-link clicks. Inquiry form contents are not sent to analytics.</p><h2>External messaging</h2><p>WhatsApp, Facebook and your email provider have their own privacy practices. Their policies apply when you use those services.</p></div>}
{page==='quotation-terms'&&<div class="prose"><h2>Indicative catalog prices</h2><p>Any prices shown on this website are indicative PHP prices. Your written quotation confirms product pricing, quantity, pack contents, availability and delivery charges.</p><h2>A request is the first step</h2><p>Submitting a quotation request does not reserve stock or constitute an accepted order. We’ll discuss details and confirm how to proceed.</p><h2>Availability and alternatives</h2><p>Product availability and options may change. We will discuss substitutions with you rather than assuming an alternative is acceptable.</p><h2>Bulk and customised requests</h2><p>Minimum quantities, artwork, production feasibility, lead times and any sample requirements are confirmed individually. Do not rely on an unconfirmed target date.</p><h2>Delivery and quotation validity</h2><p>Delivery fees, dispatch arrangements and the quotation validity period are specified in your quotation. Contact us if a quotation needs updating or if your requirements change.</p><h2>Questions or concerns</h2><p>Contact us about incorrect or damaged items so we can assess the issue with you. These terms do not limit rights available under applicable law.</p><a class="button secondary" href="/contact/">Contact us</a></div>}
{page==='quote-confirmation'&&<div class="prose"><h2>Thanks for sharing your requirements.</h2><p>Your reference: <strong id="confirmation-reference">Check the reference provided after submission.</strong></p><p>Renz will review your request and contact you using the details you supplied. Pricing, availability and delivery will be confirmed by quotation. Your request is not an accepted order.</p><div class="button-row"><a class="button" href="/products/">Back to the catalog</a><a class="text-link" href="/contact/">Contact us ↗</a></div></div>}
</section></Base>
