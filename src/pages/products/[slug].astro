---
import ProductDescription from '../../components/ProductDescription.astro';
import Base from '../../layouts/Base.astro';import ProductCard from '../../components/ProductCard.astro';import Icon from '../../components/Icon.astro';import {products,settings,categories,catalog,price,image,summary,wa} from '../../lib/catalog';
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}const {product:p}=Astro.props;const category=categories.find(c=>c.slug===p.category)!;const url=new URL(`/products/${p.slug}/`,Astro.site).href;const message=`Hello Octo18! I'd like to inquire about ${p.name}. ${url}`;
const schema={'@context':'https://schema.org','@graph':[{'@type':'Product',name:p.name,image:p.images.map(i=>new URL(i.url,Astro.site).href),description:summary(p),sku:p.sku,brand:{'@type':'Brand',name:p.brand},...(p.variants.every(v=>v.price>0)?{offers:{'@type':'AggregateOffer',priceCurrency:'PHP',lowPrice:Math.min(...p.variants.map(v=>v.price)),highPrice:Math.max(...p.variants.map(v=>v.price)),offerCount:p.variants.length,url}}:{})},{'@type':'BreadcrumbList',itemListElement:[{name:'Home',item:new URL('/',Astro.site).href},{name:category.name,item:new URL(`/categories/${category.slug}/`,Astro.site).href},{name:p.name,item:url}].map((x,i)=>({'@type':'ListItem',position:i+1,...x}))}]};
---
<Base title={p.seoTitle||`${p.name} | Manila`} description={p.seoDescription||summary(p)} schema={schema}><div class="container content-section"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href={`/categories/${category.slug}/`}>{category.name}</a><span>/</span><span>{p.brand}</span></div><div class="product-detail" data-product-detail><div><div class="main-image"><img id="main-product-image" src={image(p)} alt={p.images[0]?.alt||p.name} width="600" height="600" referrerpolicy="no-referrer"/></div><div class="thumbnails" aria-label="Product images">{p.images.map((im,i)=><button data-image={im.url} data-alt={im.alt} aria-label={`Show image ${i+1}`} aria-pressed={i===0}><img src={im.url} alt="" width="72" height="72" loading="lazy" referrerpolicy="no-referrer"/></button>)}</div></div><div class="product-info"><span class="eyebrow">{p.brand} · {category.name}</span><h1>{p.name}</h1><div class="detail-price" data-detail-price>{price(p)}</div><p class="note">Final price and availability confirmed by quotation.</p>{catalog.preview&&<p class="admin-warning">Preview build: these changes are not yet live.</p>}<div class="field"><label for="variant">Choose an option</label><select id="variant">{p.variants.map(v=><option value={v.id} data-price={v.price>0?v.price:''}>{v.name}</option>)}</select></div><div class="quantity-row"><div class="field"><label for="quantity">Quantity</label><input id="quantity" type="number" min="1" max="1000000" value="1" inputmode="numeric"/></div><button class="button" data-add-quote><Icon name="bag"/> Add to quote list</button></div><p class="note">Selling unit: {p.unit||'Please confirm pack contents with us.'}</p><div class="channels"><a class="whatsapp" data-inquiry="whatsapp" data-channel="whatsapp" href={wa(message)}><Icon name="chat" size={17}/> WhatsApp inquiry</a><a data-inquiry="email" data-channel="email" href={`mailto:${settings.email}?subject=${encodeURIComponent(`Inquiry: ${p.name}`)}&body=${encodeURIComponent(message)}`}><Icon name="mail" size={17}/> Email inquiry</a>{settings.facebook?<a href={settings.facebook} data-channel="messenger"><Icon name="chat" size={17}/> Messenger</a>:<span class="messenger-pending">Messenger link coming soon</span>}<a data-channel="call" href={`tel:${settings.phone}`}><Icon name="phone" size={17}/> Call us</a><a href={`/request-a-quote/?product=${p.id}`} data-direct-quote>Request a quotation</a><button data-copy-inquiry>Copy inquiry summary</button></div><table class="specs"><tbody><tr><td>Brand</td><td>{p.brand}</td></tr><tr><td>Product reference</td><td>{p.sku}</td></tr><tr><td>Pickup</td><td>Tondo, Manila by arrangement</td></tr></tbody></table><a class="text-link" href="/delivery/">Delivery & shipping information ↗</a></div></div><section class="prose"><h2>A closer look</h2><ProductDescription text={p.description||'Contact us for product specifications, pack contents and available options.'}/></section><section class="section"><div class="section-heading"><h2>A few more for your list.</h2></div><div class="product-grid">{products.filter(other=>other.category===p.category&&other.id!==p.id).slice(0,4).map(product=><ProductCard product={product}/>)}</div></section></div><div class="mobile-product-actions"><a class="button" href="#quantity">Request a quote</a><a class="button secondary" data-inquiry="whatsapp" data-channel="whatsapp" href={wa(message)}>WhatsApp</a></div><script id="product-data" type="application/json" set:html={JSON.stringify({id:p.id,name:p.name,slug:p.slug,unit:p.unit,variants:p.variants.map(v=>({id:v.id,name:v.name,sku:v.sku})),phone:settings.phone,email:settings.email}).replace(/</g,'\u003c')}/></Base>
