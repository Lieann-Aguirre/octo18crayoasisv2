---
import ProductCard from './ProductCard.astro';
import {categories} from '../lib/catalog';
import type {Product} from '../lib/model';
const {products,category='',collection=''}=Astro.props as {products:Product[],category?:string,collection?:string};
const brands=[...new Set(products.map(p=>p.brand))].sort();
const schema={'@context':'https://schema.org','@type':'CollectionPage',name:category||collection||'All products',mainEntity:{'@type':'ItemList',itemListElement:products.map((p,i)=>({'@type':'ListItem',position:i+1,url:new URL(`/products/${p.slug}/`,Astro.site).href,name:p.name}))}};
---
<script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/>
<div class="container catalog-layout" data-catalog><button class="button secondary filter-toggle" type="button" aria-expanded="false" aria-controls="catalog-filters">Filters</button><aside id="catalog-filters" class="filters" aria-label="Product filters"><div class="filter-heading"><h2>Find your essentials</h2><button type="button" class="filter-close" aria-label="Close filters">✕</button></div><div class="filter-field"><label for="category-filter">Category</label><select id="category-filter" data-filter="category"><option value="">All categories</option>{categories.map(c=><option value={c.slug} selected={category===c.slug}>{c.name}</option>)}</select></div><div class="filter-field"><label for="brand-filter">Brand</label><select id="brand-filter" data-filter="brand"><option value="">All brands</option>{brands.map(b=><option>{b}</option>)}</select></div><div class="filter-field"><label for="size-filter">Paper size</label><select id="size-filter" data-filter="size"><option value="">All sizes</option>{['A3','A4','Short','Long','Legal'].map(s=><option>{s}</option>)}</select></div><div class="filter-field"><label for="gsm-filter">Paper weight</label><select id="gsm-filter" data-filter="gsm"><option value="">All GSM</option>{['70','80','100','230'].map(s=><option value={s}>{s} GSM</option>)}</select></div><div class="filter-field"><label for="color-filter">Ink colour</label><select id="color-filter" data-filter="color"><option value="">All colours</option>{['Black','Blue','Red','Violet','Assorted'].map(s=><option>{s}</option>)}</select></div><div class="filter-field"><label for="pack-filter">Pack quantity</label><select id="pack-filter" data-filter="pack"><option value="">All packs</option>{['12','100','250','500'].map(s=><option value={s}>{s} pieces / sheets</option>)}</select></div><button class="reset" data-reset>Reset filters</button></aside><div class="catalog-products"><form class="search-form" role="search"><label class="sr-only" for="catalog-search">Search products</label><input id="catalog-search" name="q" type="search" placeholder="Search pens, A4 paper, brands…"/><button class="button" type="submit">Search</button></form><div class="active-filters" aria-label="Active filters"></div><div class="results-count" role="status" aria-live="polite" data-result-count>{products.length} essentials to explore</div><div class="product-grid">{products.map(p=><div data-search-card data-category={p.category} data-brand={p.brand} data-search={`${p.name} ${p.description} ${p.sku} ${p.unit} ${p.variants.map(v=>`${v.name} ${v.sku}`).join(' ')}`.toLowerCase()}><ProductCard product={p}/></div>)}</div><div class="empty-state" data-no-results hidden><h3>No matches just yet.</h3><p>Try a different search or send us your supply list.</p><a class="button secondary" href="/request-a-quote/">Ask us to source it</a></div></div></div>
