---
import '../styles/global.css';
import {settings,catalog,wa} from '../lib/catalog';
import Icon from '../components/Icon.astro';
const {title='Stationery for every bright idea',description=settings.seoDescription,noindex=false,schema,wide=false}=Astro.props;
const origin=Astro.site||new URL('https://octo18.example');const canonical=new URL(Astro.url.pathname,origin).href;
const ga=import.meta.env.PUBLIC_GA_ID;const business={'@context':'https://schema.org','@type':'Store','name':settings.businessName,url:origin.href,telephone:settings.phone,email:settings.email,address:{'@type':'PostalAddress',addressLocality:'Manila',addressCountry:'PH'},areaServed:'Metro Manila',...(settings.facebook?{sameAs:[settings.facebook]}:{})};
---
<!doctype html><html lang="en-PH"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#123f8b"/><title>{title} | Octo18 Crayoasis</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex||catalog.preview?'noindex, nofollow':'index, follow'}/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} | Octo18 Crayoasis`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:locale" content="en_PH"/><meta property="og:image" content={new URL('/og-cover.png',origin).href}/><link rel="icon" href="/favicon.png" type="image/png"/><link rel="apple-touch-icon" href="/apple-touch-icon.png"/><script type="application/ld+json" set:html={JSON.stringify(schema||business).replace(/</g,'\u003c')}/>{ga&&/^G-[A-Z0-9]+$/.test(ga)&&<><script async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}/><script is:inline define:vars={{ga}}>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga,{send_page_view:true});</script></>}</head><body>
<a class="skip" href="#main">Skip to content</a>
<div class="topline"><div class="container"><span><Icon name="pin" size={14}/> Your neighbourhood stationery partner · Manila, PH</span><a href="/delivery/">Metro Manila delivery & Tondo pickup <span aria-hidden="true">↗</span></a></div></div>
<header class="header"><div class="container header-inner"><a class="logo" href="/" aria-label="Octo18 Crayoasis home"><img class="brand-logo compact-logo" src="/brand/logo-compact.png" width="218" height="60" alt="Octo18 CrayOasis" fetchpriority="high"/></a><nav aria-label="Main navigation"><a href="/products/" aria-current={Astro.url.pathname.startsWith('/products')?'page':undefined}>Shop supplies</a><a href="/categories/">Categories</a><a href="/bulk-custom-orders/">Bulk & custom</a><a href="/about/">Our story</a></nav><a class="quote-nav" href="/request-a-quote/"><Icon name="bag"/> <span>Quote list</span><b data-quote-count>0</b></a><button class="mobile-menu" aria-label="Toggle navigation" aria-expanded="false"><Icon name="menu"/></button></div><nav class="mobile-nav" hidden aria-label="Mobile navigation"><a href="/products/">Shop supplies</a><a href="/categories/">Categories</a><a href="/bulk-custom-orders/">Bulk & custom orders</a><a href="/about/">Our story</a><a href="/contact/">Contact us</a></nav></header>
{catalog.preview&&<div class="preview-label">Catalog preview · This is a preview build. Prices are indicative.</div>}
<main id="main" class:list={[wide?'':'page-main']}><slot/></main>
<section class="contact-band"><div class="container"><div><span class="eyebrow">LET’S GET YOUR LIST SORTED</span><h2>A little help for your next big idea.</h2><p>One notebook or a whole office restock — we’re happy to help.</p></div><a class="button white" href="/contact/">Talk to us <Icon name="arrow"/></a></div></section>
<footer><div class="container footer-grid"><div><a class="footer-brand" href="/" aria-label="Octo18 CrayOasis home"><img class="brand-logo full-logo" src="/brand/logo-full.png" width="325" height="144" alt="Octo18 CrayOasis — Stationery Trading" loading="lazy"/><span>Good supplies. Brighter possibilities.</span></a><p>Stationery, school and office essentials<br/>from Manila, with care.</p><div class="social-links"><a href={wa('Hello Octo18! I have a stationery inquiry.')} data-channel="whatsapp">WhatsApp ↗</a>{settings.facebook&&<a href={settings.facebook} data-channel="messenger">Facebook ↗</a>}</div></div><div><h3>Explore</h3><a href="/products/">All products</a><a href="/collections/school/">School supplies</a><a href="/collections/office/">Office supplies</a><a href="/bulk-custom-orders/">Bulk & custom orders</a></div><div><h3>Here to help</h3><a href="/request-a-quote/">Request a quotation</a><a href="/delivery/">Delivery & pickup</a><a href="/faq/">Frequently asked questions</a><a href="/about/">About us</a></div><div><h3>Say hello</h3><a href={`tel:${settings.phone}`}>{settings.phone}</a><a class="email" href={`mailto:${settings.email}`}>{settings.email}</a><p>Tondo, Manila, Philippines<br/>Pickup by arrangement</p><a href="/contact/">Contact details ↗</a></div></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} Octo18 Crayoasis Stationery</span><div><a href="/privacy/">Privacy</a><a href="/quotation-terms/">Quotation terms</a></div><span>Made for everyday possibilities <span class="sun">✳</span></span></div></footer>
<div class="toast" role="status" aria-live="polite" hidden></div>
<script>import '../scripts/site';</script>
</body></html>
