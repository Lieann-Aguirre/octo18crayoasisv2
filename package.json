{
  "name": "octo18-crayoasis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/sync-catalog.mjs && astro build && node scripts/verify-export.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc -p tsconfig.worker.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "import": "node scripts/import-workbooks.mjs",
    "seed": "node scripts/seed.mjs",
    "api:dev": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply octo18 --local",
    "check:api-config": "node scripts/check-api-config.mjs",
    "deploy:api": "npm run check:api-config && wrangler deploy"
  },
  "dependencies": {
    "astro": "^7.4.0",
    "jose": "^6.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.45.0"
  }
}
